{
  "manifest_version": 3,
  "name": "Basic Autocorrect",
  "version": "1.0.0",
  "description": "Autocorrect for your browser. Fixes obvious typos as you type. Works locally: your keystrokes never leave your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Basic Autocorrect",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/popup/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "src/engine/data.js",
        "src/engine/data-common.js",
        "src/engine/engine.js",
        "src/spell/bloom.js",
        "src/spell/spell.js",
        "src/shared/settings.js",
        "src/content/fields.js",
        "src/content/gdocs.js",
        "src/content/content.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "basic-autocorrect@waldgrave.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/spell/words.txt",
        "src/spell/known.bin"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "homepage_url": "https://waldgrave.com/basicautocorrect"
}
